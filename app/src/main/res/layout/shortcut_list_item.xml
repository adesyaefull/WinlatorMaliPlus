<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/CardRoot"
    android:layout_width="190dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:layout_marginTop="10dp"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:clipChildren="false"
    android:focusable="true"
    android:foreground="?android:selectableItemBackground"
    app:cardBackgroundColor="#3D75C8"
    app:cardCornerRadius="18dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:id="@+id/LLInnerArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="3dp"
        android:background="@drawable/shortcut_card_content"
        android:orientation="vertical"
        android:paddingBottom="8dp">

        <FrameLayout
            android:id="@+id/FLShortcutCover"
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:background="@drawable/shortcut_cover_frame"
            android:clipToOutline="true">

            <ImageView
                android:id="@+id/ImageView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/shortcut_cover_art"
                android:scaleType="centerCrop"
                android:src="@drawable/cover_art_placeholder" />

            <ImageButton
                android:id="@+id/BTMenu"
                style="@style/ListMenuButton"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:background="@drawable/glass_menu_button"
                android:contentDescription="@string/more_options"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/icon_list_item_menu"
                app:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/BTPlayLandscape"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="top|start"
                android:layout_margin="8dp"
                android:background="@drawable/shortcut_play_button"
                android:contentDescription="@string/play_shortcut"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/icon_play"
                android:visibility="gone"
                app:tint="#FFFFFF" />

        </FrameLayout>

        <TextView
            android:id="@+id/TVTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="10dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="2"
            android:breakStrategy="balanced"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="9dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/TVSubtitle"
                android:layout_width="0dp"
                android:layout_height="22dp"
                android:layout_weight="1"
                android:background="@drawable/badge_wine_bg"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:textColor="#E0E0E0"
                android:textSize="9sp" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/TVVersion"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:layout_marginStart="5dp"
                android:background="@drawable/badge_version_bg"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:textColor="#70E9FF"
                android:textSize="9sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/BTPlay"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/shortcut_play_button"
                android:contentDescription="@string/play_shortcut"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/icon_play"
                app:tint="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
