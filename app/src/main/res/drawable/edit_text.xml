<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="?attr/semanticSurfaceVariant" />
            <stroke android:width="1dp" android:color="?attr/semanticDivider" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="?attr/gamingSurfaceColor" />
            <stroke android:width="1dp" android:color="?attr/colorAccent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="?attr/gamingSurfaceColor" />
            <stroke android:width="1dp" android:color="?attr/semanticDivider" />
        </shape>
    </item>
</selector>
