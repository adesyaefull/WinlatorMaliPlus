<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/gamingSurfaceColor" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:startColor="#26FFFFFF"
                android:centerColor="#08FFFFFF"
                android:endColor="#20FFFFFF"
                android:type="linear" />
            <corners android:radius="15dp" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#42FFFFFF"
                android:centerColor="#12F3E5FF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
            <corners android:radius="15dp" />
        </shape>
    </item>
</layer-list>
